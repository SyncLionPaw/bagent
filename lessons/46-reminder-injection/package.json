{
  "name": "bagent-lesson46",
  "displayName": "bagent 第 46 课",
  "description": "用户消息 reminder 注入：API 侧隐性规则、UI 不展示",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bagent46.open",
        "title": "bagent: 打开 Agent 面板（第 46 课）"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "bagent46",
          "title": "bagent",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "bagent46": [
        {
          "type": "webview",
          "id": "bagent46.chat",
          "name": "Agent"
        }
      ]
    },
    "configuration": {
      "title": "bagent 第 46 课",
      "properties": {
        "bagent46.apiKeyPath": {
          "type": "string",
          "default": "~/.bagent/deepseek-api-key",
          "description": "DeepSeek API Key 文件路径"
        },
        "bagent46.tavilyApiKeyPath": {
          "type": "string",
          "default": "~/.bagent/tavily-api-key",
          "description": "Tavily API Key（web_search）。第一行 tvly-...；环境变量 TAVILY_API_KEY 优先。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p . && tsc -p agent/tsconfig.json"
  },
  "dependencies": {
    "pdf-parse": "^1.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3"
  }
}
