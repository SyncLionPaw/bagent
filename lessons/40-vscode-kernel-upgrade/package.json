{
  "name": "bagent-lesson40",
  "displayName": "bagent 第 40 课",
  "description": "插件 worker 对齐 ch36 内核：Thinking、审批、截断",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bagent40.open",
        "title": "bagent: 打开 Agent 面板（ch36 内核）"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "bagent40",
          "title": "bagent",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "bagent40": [
        {
          "type": "webview",
          "id": "bagent40.chat",
          "name": "Agent"
        }
      ]
    },
    "configuration": {
      "title": "bagent 第 40 课",
      "properties": {
        "bagent40.apiKeyPath": {
          "type": "string",
          "default": "~/.bagent/deepseek-api-key",
          "description": "DeepSeek API Key 文件路径"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p . && tsc -p agent/tsconfig.json"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3"
  }
}
